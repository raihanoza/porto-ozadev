# Email Configuration
# Gunakan email Gmail Anda untuk mengirim dan menerima pesan dari contact form
EMAIL_USER=your-email@gmail.com

# App Password dari Google Account
# Cara mendapatkan App Password:
# 1. Buka https://myaccount.google.com/security
# 2. Aktifkan 2-Step Verification jika belum
# 3. Buka https://myaccount.google.com/apppasswords
# 4. Pilih "Mail" dan "Other (Custom name)"
# 5. Copy 16-digit password yang dihasilkan
EMAIL_PASSWORD=your-16-digit-app-password
